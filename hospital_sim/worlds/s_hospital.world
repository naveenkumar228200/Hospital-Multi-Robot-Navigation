<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="smart_hospital_world">

    <!-- ===================== PHYSICS & ENVIRONMENT ===================== -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"       name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>

    <gravity>0 0 -9.8</gravity>

    <!-- Ambient light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ===================== MODEL: smart_hospital ===================== -->
    <model name="smart_hospital">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- ============================================================
           FLOOR  (20 m wide × 14 m deep)
      ============================================================ -->
      <link name="floor">
        <pose>0 0 0 0 0 0</pose>
        <collision name="floor_col">
          <geometry><box><size>20 14 0.1</size></box></geometry>
        </collision>
        <visual name="floor_vis">
          <geometry><box><size>20 14 0.1</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- ============================================================
           OUTER WALLS  (h = 3 m, t = 0.2 m)
      ============================================================ -->
      <!-- top_wall (north, y = +7) -->
      <link name="top_wall">
        <pose>0 7 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>20 0.2 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>20 0.2 3</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>

      <!-- bottom_wall (south, y = -7) -->
      <link name="bottom_wall">
        <pose>0 -7 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>20 0.2 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>20 0.2 3</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>

      <!-- left_wall (west, x = -10) -->
      <link name="left_wall">
        <pose>-10 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 14 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 14 3</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>

      <!-- right_wall (east, x = +10) -->
      <link name="right_wall">
        <pose>10 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 14 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 14 3</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>

      <!-- ============================================================
           CENTRAL CORRIDOR WALLS  (x = -1 and x = +1, full depth)
      ============================================================ -->
      <!-- corridor_wall_left -->
      <link name="corridor_wall_left">
        <pose>-1 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 14 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 14 3</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>

      <!-- corridor_wall_right -->
      <link name="corridor_wall_right">
        <pose>1 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 14 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 14 3</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>

      <!-- ============================================================
           LEFT WING DIVIDERS  (x from -10 to -1)
           divider_1: ICU1 / ICU2  y = +3
           divider_2: ICU2 / Patient Room  y = 0
           divider_3: Patient Room / Medical Room  y = -3
      ============================================================ -->
      <link name="divider_1">
        <pose>-5.5 3 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>9 0.2 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>9 0.2 3</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>

      <link name="divider_2">
        <pose>-5.5 0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>9 0.2 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>9 0.2 3</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>

      <link name="divider_3">
        <pose>-5.5 -3 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>9 0.2 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>9 0.2 3</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>

      <!-- ============================================================
           RIGHT WING DIVIDERS  (x from +1 to +10)
           divider_r1: Waiting / Nurse Station  y = +2
           divider_r2: Nurse Station / Pharmacy  y = -1
           divider_r3: Pharmacy / Bathroom       y = -3.5
           divider_r4: Bathroom / Staff Room     y = -5
      ============================================================ -->
      <link name="divider_r1">
        <pose>5.5 2 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>9 0.2 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>9 0.2 3</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>

      <link name="divider_r2">
        <pose>5.5 -1 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>9 0.2 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>9 0.2 3</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>

      <link name="divider_r3">
        <pose>5.5 -3.5 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>9 0.2 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>9 0.2 3</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>

      <link name="divider_r4">
        <pose>5.5 -5 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>9 0.2 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>9 0.2 3</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>

      <!-- ============================================================
           DOORS  (0.9 m wide × 2.1 m tall gap – represented as thin
                   visual frames; collision removed for robot passage)
      ============================================================ -->
      <!-- door_icu1 -->
      <link name="door_icu1">
        <pose>-1.1 5 1.05 0 0 1.5708</pose>
        <visual name="v">
          <geometry><box><size>0.05 0.9 2.1</size></box></geometry>
          <material><ambient>0.55 0.35 0.1 1</ambient><diffuse>0.55 0.35 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- door_icu2 -->
      <link name="door_icu2">
        <pose>-1.1 1.5 1.05 0 0 1.5708</pose>
        <visual name="v">
          <geometry><box><size>0.05 0.9 2.1</size></box></geometry>
          <material><ambient>0.55 0.35 0.1 1</ambient><diffuse>0.55 0.35 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- door_patient_room -->
      <link name="door_patient_room">
        <pose>-1.1 -1.5 1.05 0 0 1.5708</pose>
        <visual name="v">
          <geometry><box><size>0.05 0.9 2.1</size></box></geometry>
          <material><ambient>0.55 0.35 0.1 1</ambient><diffuse>0.55 0.35 0.1 1</diffuse></material>
