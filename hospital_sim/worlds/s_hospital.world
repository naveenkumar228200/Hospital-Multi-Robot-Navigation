      ============================================================ -->
      <link name="icu_bed_1">
        <pose>-7 5 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.0 0.9 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.0 0.9 0.6</size></box></geometry>
