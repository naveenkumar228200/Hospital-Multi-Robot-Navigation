      ============================================================ -->
      <link name="wheelchair_1">
        <pose>-3.5 -2.5 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.65 0.65 0.9</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.65 0.65 0.9</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
