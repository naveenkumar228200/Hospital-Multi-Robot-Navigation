      <light type="point" name="light_pharmacy">
        <pose>5.5 -2.25 2.8 0 0 0</pose>
        <diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular>
        <attenuation><range>6</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
        <cast_shadows>false</cast_shadows>
      </light>

      <light type="point" name="light_corridor">
        <pose>0 0 2.8 0 0 0</pose>
        <diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular>
        <attenuation><range>14</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
        <cast_shadows>false</cast_shadows>
      </light>

    </model>

    <!-- ============================================================
         ROBOT (differential drive, starts in corridor)
    ============================================================ -->
    <model name="hospital_robot">
      <pose>0 2 0.18 0 0 0</pose>

      <link name="chassis">
        <inertial>
          <mass>10.0</mass>
          <inertia><ixx>0.3</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.4</iyy><iyz>0</iyz><izz>0.3</izz></inertia>
        </inertial>
        <collision name="chassis_col">
          <geometry><box><size>0.6 0.4 0.2</size></box></geometry>
        </collision>
        <visual name="chassis_vis">
          <geometry><box><size>0.6 0.4 0.2</size></box></geometry>
          <material><ambient>0.0 0.5 0.8 1</ambient><diffuse>0.0 0.5 0.8 1</diffuse></material>
        </visual>
      </link>

      <!-- Left wheel -->
      <link name="left_wheel">
        <pose>0 0.22 0.18 1.5708 0 0</pose>
        <inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.18</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- Right wheel -->
      <link name="right_wheel">
        <pose>0 -0.22 0.18 1.5708 0 0</pose>
        <inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.18</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- Caster front -->
      <link name="caster_front">
        <pose>0.25 0 0.05 0 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.05</radius></sphere></geometry></collision>
        <visual name="v"><geometry><sphere><radius>0.05</radius></sphere></geometry><material><ambient>0.4 0.4 0.4 1</ambient></material></visual>
      </link>

      <!-- Caster rear -->
      <link name="caster_rear">
        <pose>-0.25 0 0.05 0 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.05</radius></sphere></geometry></collision>
        <visual name="v"><geometry><sphere><radius>0.05</radius></sphere></geometry><material><ambient>0.4 0.4 0.4 1</ambient></material></visual>
      </link>

      <!-- Joints -->
      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent><child>left_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent><child>right_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <joint name="caster_front_joint" type="ball">
        <parent>chassis</parent><child>caster_front</child>
      </joint>

      <joint name="caster_rear_joint" type="ball">
        <parent>chassis</parent><child>caster_rear</child>
      </joint>

      <!-- Differential drive plugin -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.44</wheel_separation>
        <wheel_radius>0.18</wheel_radius>
        <odom_publish_frequency>10</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
      </plugin>

      <!-- 2-D Lidar for navigation -->
      <link name="lidar_link">
        <pose>0.3 0 0.25 0 0 0</pose>
        <visual name="v">
          <geometry><cylinder><radius>0.05</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.9 0.2 0.2 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material>
        </visual>
        <sensor name="lidar" type="gpu_lidar">
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>640</samples><resolution>1</resolution>
                <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range><min>0.08</min><max>10.0</max><resolution>0.01</resolution></range>
          </lidar>
          <topic>/scan</topic>
          <gz_frame_id>lidar_link</gz_frame_id>
        </sensor>
      </link>

      <joint name="lidar_joint" type="fixed">
        <parent>chassis</parent><child>lidar_link</child>
      </joint>

    </model>

  </world>
</sdf>
