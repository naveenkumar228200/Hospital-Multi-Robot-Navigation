        <visual name="v">
          <geometry><box><size>0.05 0.9 2.1</size></box></geometry>
          <material><ambient>0.55 0.35 0.1 1</ambient><diffuse>0.55 0.35 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- door_pharmacy -->
      <link name="door_pharmacy">
        <pose>1.1 -2.25 1.05 0 0 1.5708</pose>
