      <link name="icu_bed_2">
        <pose>-7 1.5 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.0 0.9 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.0 0.9 0.6</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
      <link name="icu_bed_2_pillow">
        <pose>-6.1 1.5 0.85 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.5 0.8 0.1</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>

      <!-- ============================================================
           PATIENT BED  (Patient Room, x=-5.5, y=-1.5)
      ============================================================ -->
      <link name="patient_bed_1">
        <pose>-6 -1.5 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.0 0.9 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.0 0.9 0.6</size></box></geometry>
          <material><ambient>0.1 0.5 0.2 1</ambient><diffuse>0.1 0.5 0.2 1</diffuse></material>
        </visual>
      </link>

      <!-- ============================================================
