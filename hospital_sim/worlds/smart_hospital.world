<?xml version="1.0" ?>
<sdf version="1.7">

<world name="smart_hospital">
  <plugin
    filename="gz-sim-physics-system"
    name="gz::sim::systems::Physics">
  </plugin>

  <plugin
    filename="gz-sim-user-commands-system"
    name="gz::sim::systems::UserCommands">
  </plugin>

  <plugin
    filename="gz-sim-scene-broadcaster-system"
    name="gz::sim::systems::SceneBroadcaster">
  </plugin>

  <plugin
    filename="gz-sim-sensors-system"
    name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>

  <plugin
    filename="gz-sim-imu-system"
    name="gz::sim::systems::Imu">
  </plugin>
<!-- Visitor 11 -->
<actor name="visitor_11">

  <pose>14 1 1 0 0 0</pose>

  <skin>
    <filename>
      /home/lucifer/hospital_sim/models/Walking actor(1)/meshes/walk.dae
    </filename>
  </skin>

  <animation name="walking">
    <filename>
      /home/lucifer/hospital_sim/models/Walking actor(1)/meshes/walk.dae
    </filename>
    <interpolate_x>true</interpolate_x>
  </animation>

  <script>
    <loop>true</loop>

    <trajectory id="0" type="walking">

      <!-- Start -->
      <waypoint>
        <time>0</time>
        <pose>14 1 0 0 0 3.14159</pose>
      </waypoint>

      <!-- Walk straight (East direction) -->
      <waypoint>
        <time>3</time>
        <pose>2 1 0 0 0 3.14159</pose>
      </waypoint>

      <!-- Turn around -->
      <waypoint>
        <time>3.1</time>
        <pose>2 1 0 0 0 -3.14159</pose>
      </waypoint>

      <!-- Return -->
      <waypoint>
        <time>6</time>
        <pose>14 1 0 0 0 -3.14159</pose>
      </waypoint>

      <!-- Face original direction -->
      <waypoint>
        <time>6.1</time>
        <pose>14 1 0 0 0 3.14159</pose>
      </waypoint>

    </trajectory>

  </script>

</actor>
<!-- Visitor 10-->
<actor name="visitor_10">

  <pose>14 8 1 0 0 0</pose>

  <skin>
    <filename>
      /home/lucifer/hospital_sim/models/Walking actor(1)/meshes/walk.dae
    </filename>
  </skin>

  <animation name="walking">
    <filename>
      /home/lucifer/hospital_sim/models/Walking actor(1)/meshes/walk.dae
    </filename>
    <interpolate_x>true</interpolate_x>
  </animation>

  <script>
    <loop>true</loop>

    <trajectory id="0" type="walking">

      <!-- Start -->
      <waypoint>
        <time>0</time>
        <pose>14 8 0 0 0 -1.57</pose>
      </waypoint>

      <!-- Walk straight (East direction) -->
      <waypoint>
        <time>4</time>
        <pose>14 -8 0 0 0 -1.57</pose>
      </waypoint>

      <!-- Turn around -->
      <waypoint>
        <time>4.1</time>
        <pose>14 -8 0 0 0 1.57</pose>
      </waypoint>

      <!-- Return -->
      <waypoint>
        <time>7</time>
        <pose>14 8 0 0 0 1.57</pose>
      </waypoint>

      <!-- Face original direction -->
      <waypoint>
        <time>7.1</time>
        <pose>12 11 0 0 0 0</pose>
      </waypoint>

    </trajectory>

  </script>

</actor>
