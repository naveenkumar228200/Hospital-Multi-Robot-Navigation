<pose>6 -8 0 0 0 1.57</pose>
</waypoint>
<!-- Walk straight -->
<waypoint>
<time>3</time>
<pose>6 2 0 0 0 1.57</pose>
</waypoint>
<!-- Turn around -->
<waypoint>
<time>3.1</time>
<pose>6 2 0 0 0 -1.57</pose>
</waypoint>
<!-- Return -->
<waypoint>
<time>6</time>
<pose>6 -8 0 0 0 -1.57</pose>
</waypoint>
<!-- Face original direction -->
<waypoint>
<time>6.1</time>
<pose>6 -8 0 0 0 0</pose>
</waypoint>
</trajectory>
</script>
