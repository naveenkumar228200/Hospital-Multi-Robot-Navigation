<!-- Visitor near top corridor -->
<actor name="visitor_5">

  <pose>-15 5 1 0 0 1.57</pose>

  <skin>
    <filename>
      /home/lucifer/hospital_sim/models/actor - relative paths/meshes/walk.dae
    </filename>
    <scale>1.0</scale>
  </skin>

  <animation name="walking">
    <filename>
      /home/lucifer/hospital_sim/models/actor - relative paths/meshes/walk.dae
    </filename>
    <interpolate_x>true</interpolate_x>
  </animation>

  <script>
    <loop>true</loop>

    <trajectory id="0" type="walking">

  <!-- Start -->
  <waypoint>
    <time>0</time>
    <pose>-15 5 0 0 0 3.14</pose>
  </waypoint>

  <!-- Move West for 3 seconds -->
  <waypoint>
    <time>3</time>
    <pose>-21 5 0 0 0 3.14</pose>
  </waypoint>

  <!-- Turn around -->
  <waypoint>
    <time>3.1</time>
    <pose>-21 5 0 0 0 0</pose>
  </waypoint>

  <!-- Return -->
  <waypoint>
    <time>6</time>
    <pose>-15 5 0 0 0 0</pose>
  </waypoint>

  <!-- Face West again -->
  <waypoint>
    <time>6.1</time>
    <pose>-15 5 0 0 0 3.14</pose>
  </waypoint>

</trajectory>
</script>
</actor>
<!-- Reception visitor -->
<actor name="visitor_reception">

  <pose>-21 8 1 0 0 3.14159</pose>

  <skin>
    <filename>
      /home/lucifer/hospital_sim/models/actor - relative paths/meshes/walk.dae
    </filename>
    <scale>1.0</scale>
  </skin>

  <animation name="walking">
    <filename>
      /home/lucifer/hospital_sim/models/actor - relative paths/meshes/walk.dae
    </filename>
    <interpolate_x>true</interpolate_x>
  </animation>

  <script>
    <loop>true</loop>

    <trajectory id="0" type="walking">

      <!-- Start -->
      <waypoint>
        <time>0</time>
        <pose>-21 8 0 0 0 -3.14159</pose>
      </waypoint>

      <!-- Walk East -->
      <waypoint>
        <time>5</time>
        <pose>2 8 0 0 0 3.14159</pose>
      </waypoint>

      <!-- Turn around -->
      <waypoint>
        <time>5.1</time>
        <pose>2 8 0 0 0 -3.14159</pose>
      </waypoint>

      <!-- Return -->
      <waypoint>
        <time>7</time>
        <pose>-21 8 0 0 0 -3.14159</pose>
      </waypoint>

      <!-- Face original direction -->
      <waypoint>
        <time>7.1</time>
        <pose>-21 8 0 0 0 3.14159</pose>
      </waypoint>

    </trajectory>

  </script>

</actor>
 <!-- LIGHT -->
  <light name="sun_light" type="directional">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 20 0 0 0</pose>
    <diffuse>1 1 1 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>
    <direction>-0.5 0.1 -0.9</direction>
  </light>
  <!--Tubelight-->
  <!-- ===================== TUBE LIGHT MODEL ===================== -->

<model name="tube_light_1">
  <static>true</static>

  <pose>-5.5 5 2.8 0 0 0</pose>

  <link name="link">

    <!-- Tube body -->

    <visual name="tube_visual">

      <geometry>
        <box>
          <size>1.2 0.08 0.08</size>
        </box>
      </geometry>

      <material>
        <ambient>1 1 1 1</ambient>
        <diffuse>1 1 1 1</diffuse>
        <emissive>1 1 1 1</emissive>
      </material>

    </visual>

    <!-- Light source -->

    <light name="tube_light" type="point">

      <pose>0 0 0 0 0 0</pose>

      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <attenuation>
        <range>8</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <cast_shadows>false</cast_shadows>

    </light>

  </link>

</model>
  
<!-- FLOOR -->
<model name="floor">

  <static>true</static>

  <link name="link">

    <!-- Collision -->
    <collision name="collision">
      <geometry>
        <box>
          <size>60 40 0.1</size>
        </box>
      </geometry>
    </collision>


    <!-- Visual -->
    <visual name="visual">

      <geometry>
        <box>
          <size>60 40 0.1</size>
        </box>
      </geometry>

      <material>
        <ambient>0.78 0.88 0.96 1</ambient>
        <diffuse>0.82 0.92 1 1</diffuse>
        <specular>1 1 1 1</specular>
        <emissive>0.02 0.02 0.02 1</emissive>
      </material>

    </visual>

  </link>

</model>


