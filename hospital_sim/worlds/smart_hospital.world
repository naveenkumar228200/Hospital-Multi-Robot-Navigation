<!-- ICU ROOM LIGHTS -->
<!-- ================================================= -->

<!-- ICU Light 1 -->
<model name="icu_light_1">
  <static>true</static>

  <!-- x y z roll pitch yaw -->
  <pose>-20 13 2.8 0 0 0</pose>

  <link name="link">

    <!-- Tube shape -->
    <visual name="visual">
      <geometry>
        <box>
          <size>0.08 1.2 0.08</size>
        </box>
      </geometry>

      <material>
        <ambient>1 1 1 1</ambient>
        <diffuse>1 1 1 1</diffuse>
        <emissive>1 1 1 1</emissive>
      </material>
    </visual>

    <!-- Actual light -->
    <light name="light_source" type="point">
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>

      <attenuation>
        <range>10</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <cast_shadows>false</cast_shadows>
    </light>

  </link>
</model>

