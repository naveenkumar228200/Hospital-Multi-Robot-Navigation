<!-- corridor to nurse_table visitor -->
<actor name="visitor_1">

  <pose>-5 -2 1 0 0 0</pose>

  <skin>
    <filename>/home/lucifer/hospital_sim/models/Walking actor(1)/meshes/walk.dae</filename>
  </skin>

  <animation name="walking">
    <filename>/home/lucifer/hospital_sim/models/Walking actor(1)/meshes/walk.dae</filename>
    <interpolate_x>true</interpolate_x>
  </animation>

  <script>
    <loop>true</loop>

    <trajectory id="0" type="walking">

      <!-- Start -->
      <waypoint>
        <time>0</time>
        <pose>-5 -2 0 0 0 0</pose>
      </waypoint>

      <!-- Walk forward -->
      <waypoint>
        <time>5</time>
        <pose>2 -2 0 0 0 0</pose>
      </waypoint>

      <!-- Turn around -->
      <waypoint>
        <time>5.1</time>
        <pose>2 -2 0 0 0 3.14159</pose>
      </waypoint>

      <!-- Return -->
      <waypoint>
        <time>10</time>
        <pose>-5 -2 0 0 0 3.14159</pose>
      </waypoint>

      <!-- Face forward again -->
      <waypoint>
        <time>10.1</time>
        <pose>-5 -2 0 0 0 0</pose>
      </waypoint>

    </trajectory>
  </script>

</actor>
<!-- nurse4 to icu visitor -->
<actor name="casual_female_1">

  <pose>-5 4 0 0 0 -1.45</pose>

  <skin>
    <filename>/home/lucifer/hospital_sim/models/Casual female(1)/meshes/casual_female.dae</filename>
    <scale>1.0</scale>
  </skin>

  <animation name="walking">
    <filename>/home/lucifer/hospital_sim/models/Casual female(1)/meshes/casual_female.dae</filename>
    <interpolate_x>true</interpolate_x>
  </animation>

  <script>
    <loop>true</loop>

    <trajectory id="0" type="walking">

      <!-- Start -->
      <waypoint>
        <time>0</time>
        <pose>-1 4 0 0 0 -1.45</pose>
      </waypoint>

      <!-- Move right -->
      <waypoint>
        <time>4</time>
        <pose>-1 -4 0 0 0 0</pose>
      </waypoint>

      <!-- Turn left -->
      <waypoint>
        <time>4.1</time>
        <pose>-4 -4 0 0 0 1.57</pose>
      </waypoint>

      <!-- Go straight -->
      <waypoint>
        <time>8</time>
        <pose>-4 -10 0 0 0 1.57</pose>
      </waypoint>

      <!-- Turn around -->
      <waypoint>
        <time>8.1</time>
        <pose>-4 -10 0 0 0 -1.57</pose>
      </waypoint>

      <!-- Return down -->
      <waypoint>
        <time>12</time>
        <pose>-1 -4 0 0 0 -1.57</pose>
      </waypoint>

      <!-- Face start direction -->
      <waypoint>
        <time>12.1</time>
        <pose>-4 -4 0 0 0 -3.14</pose>
      </waypoint>

      <!-- Return to start -->
      <waypoint>
        <time>16</time>
        <pose>-1 4 0 0 0 -3.14</pose>
      </waypoint>

      <!-- Reset orientation -->
      <waypoint>
        <time>16.1</time>
        <pose>-1 4 0 0 0 0</pose>
      </waypoint>

    </trajectory>
  </script>

</actor>
