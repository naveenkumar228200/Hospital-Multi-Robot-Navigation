<?xml version="1.0"?>
<sdf version="1.6">
  <model name="tubelight">
    <static>true</static>
    <link name="base_link">
      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://tubelight/meshes/tubelight.dae</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name= "TubeLight_visual">
        <geometry>
          <mesh>
            <uri>model://tubelight/meshes/tubelight.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>model://tubelight/materials/textures/TubeLight_Albedo.png</albedo_map>
              <normal_map>model://tubelight/materials/textures/TubeLight_Normal.png</normal_map>
              <metalness_map>model://tubelight/materials/textures/TubeLight_Metalness.png</metalness_map>
              <roughness_map>model://tubelight/materials/textures/TubeLight_Roughness.png</roughness_map>
              <emissive_map>model://tubelight/materials/textures/TubeLight_Emissive.png</emissive_map>
            </metal>
          </pbr>
          <!-- fallback to script if no PBR support-->
          <script>
            <uri>model://tubelight/materials/textures</uri>
            <uri>model://tubelight/materials/scripts</uri>
            <name>TubeLight/Light_Diffuse</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
